GEMINI_API_KEY=tu_api_key_de_google_ai_studio
# Lista ordenada por prioridad; si un modelo devuelve 429 se pasa al siguiente.
# (Si se omite, se usa GEMINI_MODEL + los dos Gemma de respaldo.)
GEMINI_MODELS=gemini-3.5-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
# Opcionales (valores por defecto):
# CHAT_RATE_LIMIT=10          # peticiones por minuto por IP
# CHAT_MIN_RESPONSE_MS=2000   # tiempo mínimo de respuesta
# TRUST_PROXY=0               # 1 cuando está detrás de nginx
