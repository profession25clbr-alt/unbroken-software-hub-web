GEMINI_API_KEY=tu_api_key_de_google_ai_studio
# Lista ordenada por prioridad; si un modelo devuelve 429 o falla (5xx / timeout)
# se pasa al siguiente. Si se omite, se usa esta misma cadena por defecto.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-3.6-flash,gemma-4-31b-it
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
# Opcionales (valores por defecto):
# CHAT_RATE_LIMIT=10          # peticiones por minuto por IP
# CHAT_MIN_RESPONSE_MS=2000   # tiempo mínimo de respuesta
# TRUST_PROXY=0               # 1 cuando está detrás de nginx
